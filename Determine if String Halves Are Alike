class Solution {
    public boolean halvesAreAlike(String s) {
        String vowels = "aeiouAEIOU";
        int half = s.length() / 2;
        int count = 0;

        for (int i = 0; i < half; i++) {
            if (vowels.indexOf(s.charAt(i)) != -1) {
                count++;
            }
        }

        for (int i = half; i < s.length(); i++) {
            if (vowels.indexOf(s.charAt(i)) != -1) {
                count--;
            }
        }

        return count == 0;
    }
}
